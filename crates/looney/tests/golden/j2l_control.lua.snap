local x = 0
if jsTruthy(jsStrictEq(x, 0)) then
  x = 1
elseif jsTruthy(jsStrictEq(x, 2)) then
  x = 3
else
  x = 4
end
assert(jsStrictEq(x, 1))
local i = 0
while jsTruthy(jsLt(i, 5)) do
  i = jsAdd(i, 1)
end
assert(jsStrictEq(i, 5))
local total = 0
for j = 1, 10, 1 do
  total = jsAdd(total, j)
end
assert(jsStrictEq(total, 55))
for j = 10, 1, -2 do
  total = jsAdd(total, 1)
end
assert(jsStrictEq(total, 60))
for j = 1, 0, 1 do
  total = jsAdd(total, 100)
end
assert(jsStrictEq(total, 60))
local k = 0
while jsTruthy(true) do
  k = jsAdd(k, 1)
  if jsTruthy(jsGe(k, 3)) then
    break
  end
end
assert(jsStrictEq(k, 3))
jsLog("ok")
