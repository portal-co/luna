local a = jsAdd(1, jsMul(2, 3))
assert(jsStrictEq(a, 7))
local b = jsDiv(10, 4)
assert(jsStrictEq(b, 2.5))
local c = jsPow(2, 10)
assert(jsStrictEq(c, 1024))
assert(jsStrictEq(jsRem(-7, 2), -1))
assert(jsStrictEq(jsRem(7, -2), 1))
assert(jsStrictEq(1000, 1000))
assert(jsStrictEq(16, 16))
jsLog("ok")
