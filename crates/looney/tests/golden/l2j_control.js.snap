let x = 0;
if (luaTruthy(luaEq(x, 0))) {
    x = 1;
} else if (luaTruthy(luaEq(x, 2))) {
    x = 3;
} else {
    x = 4;
}
assert(luaEq(x, 1));
let i = 0;
while(luaTruthy(luaLt(i, 5))){
    i = luaAdd(i, 1);
}
assert(luaEq(i, 5));
let total = 0;
{
    let lua$limit = 10;
    let lua$step = 1;
    for(let j = 1; lua$step > 0 ? j <= lua$limit : j >= lua$limit; j = luaAdd(j, lua$step)){
        total = luaAdd(total, j);
    }
}assert(luaEq(total, 55));
{
    let lua$limit = 1;
    let lua$step = -2;
    for(let j = 10; lua$step > 0 ? j <= lua$limit : j >= lua$limit; j = luaAdd(j, lua$step)){
        total = luaAdd(total, 1);
    }
}assert(luaEq(total, 60));
{
    let lua$limit = 0;
    let lua$step = 1;
    for(let j = 1; lua$step > 0 ? j <= lua$limit : j >= lua$limit; j = luaAdd(j, lua$step)){
        total = luaAdd(total, 100);
    }
}assert(luaEq(total, 60));
let k = 0;
while(luaTruthy(true)){
    k = luaAdd(k, 1);
    if (luaTruthy(luaGe(k, 3))) {
        break;
    }
}
assert(luaEq(k, 3));
print("ok");
