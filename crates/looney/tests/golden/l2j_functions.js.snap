let fib = function fib(n) {
    n = n === void 0 ? null : n;
    if (luaTruthy(luaLt(n, 2))) {
        return n;
    }
    return luaAdd(luaCall(fib, [
        luaSub(n, 1)
    ]), luaCall(fib, [
        luaSub(n, 2)
    ]));
};
luaCall(assert, [
    luaEq(luaCall(fib, [
        10
    ]), 55)
]);
let apply = function apply(f, x) {
    f = f === void 0 ? null : f;
    x = x === void 0 ? null : x;
    return luaCall(f, [
        x
    ]);
};
luaCall(assert, [
    luaEq(luaCall(apply, [
        function(v) {
            v = v === void 0 ? null : v;
            return luaMul(v, 2);
        },
        21
    ]), 42)
]);
let takes_two = function takes_two(a, b) {
    a = a === void 0 ? null : a;
    b = b === void 0 ? null : b;
    luaCall(assert, [
        luaEq(a, 1)
    ]);
    luaCall(assert, [
        luaEq(b, null)
    ]);
    return null;
};
luaCall(takes_two, [
    1
]);
luaCall(print, [
    "ok"
]);
