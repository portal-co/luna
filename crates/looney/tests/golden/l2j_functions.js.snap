let fib = function fib(n) {
    n = n === void 0 ? null : n;
    if (luaTruthy(luaLt(n, 2))) {
        return n;
    }
    return luaAdd(fib(luaSub(n, 1)), fib(luaSub(n, 2)));
    return null;
};
assert(luaEq(fib(10), 55));
let apply = function apply(f, x) {
    f = f === void 0 ? null : f;
    x = x === void 0 ? null : x;
    return f(x);
    return null;
};
assert(luaEq(apply(function(v) {
    v = v === void 0 ? null : v;
    return luaMul(v, 2);
    return null;
}, 21), 42));
let takes_two = function takes_two(a, b) {
    a = a === void 0 ? null : a;
    b = b === void 0 ? null : b;
    assert(luaEq(a, 1));
    assert(luaEq(b, null));
    return null;
};
takes_two(1);
print("ok");
