let a = luaAdd(1, luaMul(2, 3));
luaCall(assert, [
    luaEq(a, 7)
]);
let b = luaDiv(10, 4);
luaCall(assert, [
    luaEq(b, 2.5)
]);
let c = luaPow(2, 10);
luaCall(assert, [
    luaEq(c, 1024)
]);
luaCall(assert, [
    luaEq(luaMod(-7, 3), 2)
]);
luaCall(assert, [
    luaEq(luaMod(7, -3), -2)
]);
luaCall(assert, [
    luaEq(-luaPow(2, 2), -4)
]);
luaCall(assert, [
    luaEq(luaPow(2, luaPow(2, 3)), 256)
]);
luaCall(assert, [
    luaEq(1000, 1000)
]);
luaCall(assert, [
    luaEq(16, 16)
]);
luaCall(assert, [
    luaGt(luaDiv(1, 0), 1e+308)
]);
luaCall(print, [
    "ok"
]);
